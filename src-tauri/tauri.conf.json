{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "node-processor",
  "version": "0.1.0",
  "identifier": "com.chapola.node-processor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "node-processor — gerenciador de processos dev",
        "width": 1400,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#07080a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "node-processor",
    "category": "DeveloperTool",
    "shortDescription": "Gerenciador de processos dev (Node/Python/Docker/IA)",
    "longDescription": "Lista e mata processos de desenvolvimento (Node, Python, Docker, agentes de IA) rodando na maquina, agrupados por pasta de projeto, com deteccao de duplicados e consultor de limpeza por IA.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
